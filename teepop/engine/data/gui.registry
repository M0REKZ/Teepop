login
	view geom="0,0,640,480"
		frame geom="-10,250, 660, 150"
			label geom="245,25,150,16" text="Username"
			textbox name="username" geom="245,40,150,16" onenter="connect"
			label geom="245,60,200,16" text="Password (empty for guests)"
			textbox name="password" geom="245,75,150,16" hidetype onenter="connect"
			button name="connect" geom="280,110,75,20" caption="Connect" onclicked="connect"
		label geom="0,465,600,16" name="version" text="(C) Magnus Auvinen"
		button name="quit" geom="530,440,90,20" caption="Quit" onclicked="quit"
lobby
	view geom="0,0,640,480"
		textbox name="chatinput" geom="20,440,400,16" onenter="chat"
		label geom="20,35,150,16" text="Rooms"
		listbox name="rooms" geom="20,50,450,180" ondoubleclick="joinroom"
		label geom="20,235,150,16" text="Chat"
		listbox name="chat" geom="20,250,450,180"
		label geom="490,235,150,16" text="Players"
		listbox name="players" geom="490,250,130,180"
		button name="designroom" geom="490,50,75,20" caption="Create" onclicked="designroom"
designroom
	view geom="0,0,640,480"
		frame name="designroom" geom="-10,150,660,250"
			label geom="245,25,60,16" text="Room Name"
			textbox name="roomname" geom="245,40,150,16" text="My Room"
			label geom="245,60,180,16" text="Password (not implemented)"
			textbox name="password" geom="245,75,150,16"
			label geom="245,95,180,16" text="Max Players (1-4)"
			textbox name="maxplayers" geom="245,110,150,16" text="4"
			button geom="320,145,50,20" caption="Create" onclicked="createroom"
			button geom="245,145,50,20" caption="Cancel" onclicked="showlobby"
room
	view geom="0,0,640,480"
		textbox name="chatinput" geom="252,424,212,16" onenter="chat"
		label geom="252,253,328,16" text="Chat"
		listbox name="chat" geom="252,268,370,136"
		button geom="410,10,75,20" caption="Start" onclicked="startgame"
		button geom="505,10,75,20" caption="Leave" onclicked="leaveroom"
		frame name="localboard" geom="20,56,192,384"
		frame name="board1" geom="252,56,96,192"
		frame name="board2" geom="368,56,96,192"
		frame name="board3" geom="484,56,96,192"
		label name="playername1" geom="20,36,150,16"
		label name="playername2" geom="252,36,200,16"
		label name="playername3" geom="368,36,200,16"
		label name="playername4" geom="484,36,200,16"
		label name="blockcount" geom="170,36,100,16"
		frame name="nextblocks" geom="84,0,64,32"
status
	frame geom="-10,150,660,100"
		label name="status" geom="40,15,600,16"
		button name="back" geom="283,55,75,20" caption="Back" onclicked="back"

